# {{ app_name }} - Isle vLAN configuration
# Generated by Isle CLI
# Type: isle (vLAN networking with DHCP and router)

version: '3.8'

services:
  {% for service in services %}
  {{ service.name }}:
    build:
      context: ./{{ service.name }}
      dockerfile: Dockerfile
    container_name: {{ app_name }}-{{ service.name }}
    restart: unless-stopped
    {% if service.mac_address %}
    mac_address: "{{ service.mac_address }}"
    {% endif %}
    {% if service.external_port %}
    ports:
      - "{{ service.external_port }}:{{ service.internal_port }}"
    {% endif %}
    expose:
      - "{{ service.internal_port }}"
    networks:
      {{ app_name }}_net:
      {% if service.vlan_network %}
      isle-br-{{ vlan_id }}:
        priority: 100
      {% endif %}
    volumes:
      - ./ssl/certs:/ssl/certs:ro
      - ./ssl/keys:/ssl/keys:ro
    labels:
      app.type: "isle"
      app.name: "{{ app_name }}"
      service.name: "{{ service.name }}"
      subdomain: "{{ service.name }}.{{ base_domain }}"
      vlan: "{{ vlan_id }}"
      dhcp.enabled: "true"

  {% endfor %}
  proxy:
    build:
      context: ./proxy
      dockerfile: Dockerfile
    container_name: {{ app_name }}-proxy
    restart: unless-stopped
    ports:
      - "443:443"  # HTTPS
      - "80:80"    # HTTP redirect
    networks:
      {{ app_name }}_net:
      isle-br-{{ vlan_id }}:
        priority: 100
    volumes:
      - ./proxy/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./proxy/static:/etc/nginx/static:ro
      - ./ssl/certs:/ssl/certs:ro
      - ./ssl/keys:/ssl/keys:ro
    depends_on:
      {% for service in services %}
      - {{ service.name }}
      {% endfor %}
    labels:
      app.type: "isle"
      app.name: "{{ app_name }}"
      service.name: "proxy"
      role: "reverse-proxy"
      vlan: "{{ vlan_id }}"

networks:
  {{ app_name }}_net:
    driver: bridge
    name: {{ app_name }}_net
    ipam:
      config:
        - subnet: 172.{{ 20 + vlan_id }}.0.0/16

  {% if vlan_network_enabled %}
  isle-br-{{ vlan_id }}:
    driver: macvlan
    driver_opts:
      parent: isle-br-{{ vlan_id }}
    name: isle-br-{{ vlan_id }}
    external: true
  {% endif %}
