# {{ app_name }} - localhost-mdns configuration
# Generated by Isle CLI
# Type: localhost-mdns (localhost-only, no router)

version: '3.8'

services:
  {% for service in services %}
  {{ service.name }}:
    build:
      context: ./{{ service.name }}
      dockerfile: Dockerfile
    container_name: {{ app_name }}-{{ service.name }}
    restart: unless-stopped
    {% if service.external_port %}
    ports:
      - "{{ service.external_port }}:{{ service.internal_port }}"
    {% endif %}
    expose:
      - "{{ service.internal_port }}"
    networks:
      - {{ app_name }}_net
    volumes:
      - ./ssl/certs:/ssl/certs:ro
      - ./ssl/keys:/ssl/keys:ro
    labels:
      app.type: "localhost-mdns"
      app.name: "{{ app_name }}"
      service.name: "{{ service.name }}"
      subdomain: "{{ service.name }}.{{ base_domain }}"

  {% endfor %}
  proxy:
    build:
      context: ./proxy
      dockerfile: Dockerfile
    container_name: {{ app_name }}-proxy
    restart: unless-stopped
    ports:
      - "443:443"  # HTTPS
      - "80:80"    # HTTP redirect
    networks:
      - {{ app_name }}_net
    volumes:
      - ./proxy/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./proxy/static:/etc/nginx/static:ro
      - ./ssl/certs:/ssl/certs:ro
      - ./ssl/keys:/ssl/keys:ro
    depends_on:
      {% for service in services %}
      - {{ service.name }}
      {% endfor %}
    labels:
      app.type: "localhost-mdns"
      app.name: "{{ app_name }}"
      service.name: "proxy"
      role: "reverse-proxy"

networks:
  {{ app_name }}_net:
    driver: bridge
    name: {{ app_name }}_net
