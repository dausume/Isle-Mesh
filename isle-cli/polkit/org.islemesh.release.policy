<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Isle Mesh</vendor>
  <action id="org.islemesh.release.run">
    <description>Deploy a reviewed release across this isle</description>
    <message>An administrator password is required to deploy the reviewed release across this isle.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/isle-mesh/isle-cli/scripts/release-pkexec</annotate>
  </action>
</policyconfig>
