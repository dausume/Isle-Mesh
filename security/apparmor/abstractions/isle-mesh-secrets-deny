# Isle-Mesh secrets deny abstraction
# Include this in NON-isle-mesh profiles to prevent snooping on isle-mesh internals.
#
# AppArmor can only restrict confined processes, so this abstraction must be
# explicitly included in profiles of services you want to block from isle-mesh.
# Unconfined processes are NOT restricted by AppArmor - use filesystem permissions
# (isle-mesh group + 0750/0640) as the primary outward barrier.
#
# ┌─ ISOLATION MAPPING ────────────────────────────────────────────────────────┐
# │ This is the "OS → isle" half of two-way isolation: it stops other (non-isle) │
# │ programs from snooping isle-mesh internals.                                   │
# │   • containment — a compromised OS process cannot read isle SSH keys, SSL     │
# │                   private keys, agent configs, or logs (no pivot INTO isle).  │
# │   • footprint   — denying reads of br-mgmt / isle-br-* sysfs hides the isle's │
# │                   network topology from snoopers (mirrors the footprint kind  │
# │                   that isle security checks for at the config/DNS level).     │
# └────────────────────────────────────────────────────────────────────────────┘

  # [isolation: containment] Deny reading isle-mesh SSH keys and cached credentials
  # — stops an outside process from stealing the keys used to reach the router.
  deny /etc/isle-mesh/router/ssh/**     rwx,

  # Deny reading isle-mesh SSL private keys
  deny /etc/isle-mesh/agent/ssl/keys/** rwx,

  # Deny reading isle-mesh agent configs (may contain tokens/secrets)
  deny /etc/isle-mesh/agent/host-agent.conf r,

  # Deny access to isle-mesh logs (may leak network topology)
  deny /etc/isle-mesh/agent/logs/**     rwx,
  deny /var/log/isle-mesh/**            rwx,

  # [isolation: footprint] Deny probing the management/isle bridges directly.
  # Network-level isolation is handled by bridge/VLAN config (and verified by
  # isle security: route_isolation/no_nat), but this prevents an outside process
  # from reading bridge state out of sysfs to map the isle's topology.
  deny /sys/class/net/br-mgmt/**        r,
  deny /sys/class/net/isle-br-*/**      r,
