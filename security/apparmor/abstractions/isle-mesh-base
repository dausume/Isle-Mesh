# Isle-Mesh base abstraction - common rules for all isle-mesh components
# Include this in every isle-mesh profile for shared access patterns
#
# ┌─ ISOLATION MAPPING ────────────────────────────────────────────────────────┐
# │ AppArmor here provides PROCESS-LEVEL CONTAINMENT (defense-in-depth) — the    │
# │ "what can a compromised isle process touch?" barrier. It maps to the kinds   │
# │ verified by `isle security` (see isle-cli/scripts/security.sh CATEGORIES):   │
# │   • containment — a compromised isle process cannot read OS secrets/creds    │
# │                   (this file's deny block). Backs: scan_containment, and the │
# │                   "isle-mesh can't touch OS secrets" half of two-way isolation│
# │ Network-level kinds (exposure/egress/router) are enforced by firewall/route/ │
# │ VLAN config and verified by isle security — AppArmor only reinforces them.   │
# └────────────────────────────────────────────────────────────────────────────┘

  # Basic system access
  /etc/ld.so.cache          r,
  /etc/ld.so.preload        r,
  /etc/nsswitch.conf        r,
  /etc/passwd               r,
  /etc/group                r,
  /etc/host.conf            r,
  /etc/hosts                r,
  /etc/resolv.conf          r,
  /etc/gai.conf             r,
  /lib/{,**/}*.so*          mr,
  /usr/lib/{,**/}*.so*      mr,
  /usr/share/locale/**      r,

  # Proc/sys basics
  @{PROC}/sys/kernel/osrelease  r,
  @{PROC}/sys/kernel/hostname   r,
  owner @{PROC}/@{pid}/fd/     r,
  owner @{PROC}/@{pid}/status  r,

  # Temp (private per PrivateTmp in systemd)
  owner /tmp/**              rw,

  # [isolation: containment] Deny access to sensitive host paths isle-mesh should
  # never touch. If any confined isle process is compromised, it still cannot read
  # OS SSH keys, GPG keyrings, cloud creds, /etc/shadow or sudoers — blocking
  # credential theft and lateral movement off the isle into the real system.
  # This is the "isle → OS" half of two-way isolation.
  deny /home/*/.ssh/**       rwx,
  deny /home/*/.gnupg/**     rwx,
  deny /home/*/.config/gcloud/** rwx,
  deny /home/*/.aws/**       rwx,
  deny /root/.ssh/**         rwx,
  deny /root/.gnupg/**       rwx,
  deny /etc/shadow           rwx,
  deny /etc/gshadow          rwx,
  deny /etc/sudoers          rwx,
  deny /etc/sudoers.d/**     rwx,
