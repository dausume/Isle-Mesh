# AppArmor profile for mesh-mdns-broadcast.sh
# Systemd service: mesh-mdns.service
# Binary: /usr/local/bin/isle-mesh/mesh-mdns-broadcast.sh
#
# Purpose: Broadcasts mDNS service announcements for isle-mesh apps.
# This is the most restricted profile - it only needs mDNS and its config.
#
# ISOLATION MAPPING (vs. isle security kinds):
#   • containment — tiny blast radius: if the broadcaster is compromised it can
#                   only speak mDNS and read its own config (no Docker, no secrets).
#   • egress      — network is clamped to mDNS multicast only; TCP is denied, so a
#                   compromised broadcaster cannot open outbound connections. This
#                   reinforces the egress kind (isle traffic can't escape outward).

#include <tunables/global>

profile isle-mesh-mdns /usr/local/bin/isle-mesh/mesh-mdns-broadcast.sh flags=(complain) {
  #include <abstractions/base>
  #include <abstractions/bash>
  #include <abstractions/nameservice>
  #include if exists <local/isle-mesh-mdns>

  # Isle-Mesh base rules
  include "/home/detts/Isle-Mesh/security/apparmor/abstractions/isle-mesh-base"

  # --- Filesystem: read-only ---
  /usr/local/etc/mesh-mdns.conf             r,
  /usr/local/etc/mesh-mdns-domains.list     r,
  /etc/isle-mesh/mesh-mdns.env              r,

  # --- Executables ---
  /usr/bin/bash                         ix,
  /usr/bin/dash                         ix,
  /usr/bin/avahi-publish*               ix,
  /usr/bin/avahi-browse                 ix,
  /usr/bin/sleep                        ix,
  /usr/bin/grep                         ix,
  /usr/bin/sed                          ix,
  /usr/bin/awk                          ix,
  /usr/bin/cat                          ix,
  /usr/bin/cut                          ix,
  /usr/bin/tr                           ix,
  /usr/bin/date                         ix,
  /usr/bin/basename                     ix,
  /usr/bin/id                           ix,

  # [isolation: egress] Network clamped to mDNS only — UDP multicast + D-Bus to
  # avahi. Nothing here lets the service reach off-link or open a TCP channel.
  network inet dgram,      # UDP for mDNS multicast (224.0.0.251:5353)
  network inet6 dgram,     # UDP6 for mDNS multicast
  network unix stream,     # D-Bus to avahi-daemon

  # --- Deny: everything this service doesn't need ---
  deny network inet stream,             # [isolation: egress]    no TCP — can't dial out
  deny /var/run/docker.sock             rwx,  # [isolation: containment] no Docker = no root escalation
  deny /home/**                         rwx,  # [isolation: containment] no user data
  deny /boot/**                         rwx,  # [isolation: containment]
  deny /etc/isle-mesh/router/**         rwx,  # [isolation: containment] no router SSH keys
  deny /etc/isle-mesh/agent/ssl/**      rwx,  # [isolation: containment] no TLS private keys
}
