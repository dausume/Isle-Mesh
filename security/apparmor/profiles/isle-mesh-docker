# AppArmor profile for Docker commands executed by isle-mesh
# This restricts what isle-mesh can do with Docker, not Docker itself.
#
# Purpose: Limits isle-mesh's Docker usage to container/network/image operations
#          on isle-mesh resources only (label-filtered).
#
# ISOLATION MAPPING (vs. isle security kinds):
#   • containment — Docker is root-equivalent, so this is the highest-value confine
#                   point. Every isle component reaches Docker via Px INTO this
#                   profile, which scopes it to the daemon socket + isle resources
#                   and denies secret reads. A compromise here cannot also grab the
#                   router SSH keys or TLS keys to pivot deeper.

#include <tunables/global>

profile isle-mesh-docker /usr/bin/docker flags=(complain) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include if exists <local/isle-mesh-docker>

  # Docker CLI needs to talk to the daemon
  /var/run/docker.sock                  rw,

  # Docker binary and its dependencies
  /usr/bin/docker                       mr,
  /usr/lib/docker/**                    r,
  /usr/libexec/docker/**                r,

  # Docker config
  /root/.docker/**                      r,
  owner @{HOME}/.docker/**              r,

  # Docker data (read for inspect/logs)
  /var/lib/docker/**                    r,

  # Compose files
  /etc/isle-mesh/agent/docker-compose.yml  r,

  # Network
  network inet stream,
  network inet dgram,
  network unix stream,

  # [isolation: containment] Even root-equivalent Docker can't read isle secrets
  # through this path — caps the blast radius if a Docker invocation is hijacked.
  deny /etc/isle-mesh/router/ssh/**     rwx,
  deny /etc/isle-mesh/agent/ssl/keys/** rwx,
}
