[Unit]
Description=Publish a dated Isle device capability and resource report
After=network-online.target docker.service isle-mesh-boot.service
ConditionPathExists=/etc/isle-mesh/agent/agent.mode

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'case "$(cat /etc/isle-mesh/agent/agent.mode)" in core|remote) exit 0;; *) exit 1;; esac'
ExecStart=/usr/bin/python3 /usr/share/isle-mesh/isle-cli/scripts/capabilities.py status --publish https://api.polari.isle
Nice=15
CPUQuota=20%
MemoryMax=128M
MemorySwapMax=0
TimeoutStartSec=90
