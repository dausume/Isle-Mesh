version: '3.8'

# Isle Agent - Unified nginx proxy container

# Generated: {{ timestamp }}
# Mode: {{ mode }}
# Bridges: {{ bridges|length }}

services:
  isle-agent:
    image: nginx:alpine

    container_name: isle-agent
    restart: unless-stopped

    # Virtual MAC address for OpenWRT DHCP isolation
    # Format: 02:00:00:00:VLAN:XX (locally administered)
    mac_address: "02:00:00:00:0a:01"

    ports:
      - "80:80"
      - "443:443"

    volumes:
      # Master nginx config (merged from all app fragments)
      - /etc/isle-mesh/agent/nginx.conf:/etc/nginx/nginx.conf:ro

      # App config fragments (generated per mesh-app)
      - /etc/isle-mesh/agent/configs:/etc/nginx/configs:ro

      # SSL certificates (shared across all apps)
      - /etc/isle-mesh/agent/ssl/certs:/etc/nginx/ssl/certs:ro
      - /etc/isle-mesh/agent/ssl/keys:/etc/nginx/ssl/keys:ro

      # Agent state and logs
      - /etc/isle-mesh/agent/logs:/var/log/nginx

      # Agent registry
      - /etc/isle-mesh/agent/registry.json:/etc/isle-mesh/agent/registry.json:ro

    networks:
      # Always include internal network
      isle-agent-net:
{% if bridges %}
{% for bridge in bridges %}
      {{ bridge }}:
        # No IP assigned - will get DHCP from OpenWRT router
        priority: {{ 100 + loop.index0 * 10 }}
{% endfor %}
{% endif %}

    labels:
      isle.component: "agent"
      isle.role: "proxy"
      isle.version: "1.0.0"

    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  # Internal docker network for app containers to reach agent
  isle-agent-net:
    driver: bridge
    name: isle-agent-net
    ipam:
      config:
        - subnet: 172.21.0.0/16

{% if bridges %}
{% for bridge in bridges %}
  # Macvlan network on {{ bridge }} for OpenWRT router connectivity
  # Requirements:
  #   1. Host bridge {{ bridge }} must exist (created by router or manually)
  #   2. OpenWRT router's interface connected to {{ bridge }} bridge
  #   3. Agent uses virtual MAC (02:00:00:00:0a:01) for DHCP isolation
  {{ bridge }}:
    driver: macvlan
    driver_opts:
      parent: {{ bridge }}
    name: {{ bridge }}
{% endfor %}
{% endif %}
