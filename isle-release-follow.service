[Unit]
Description=Follow the core's reviewed release run on this member device
After=network-online.target docker.service
ConditionPathExists=/etc/isle-mesh/agent/agent.mode

[Service]
Type=oneshot
User=root
ExecCondition=/bin/sh -c 'test "$(cat /etc/isle-mesh/agent/agent.mode)" = remote'
ExecStart=/usr/bin/python3 /usr/share/isle-mesh/isle-cli/scripts/release_run.py follow --auto
# No CPU/memory caps: this pulls images and installs packages (isle update apply).
TimeoutStartSec=2h
